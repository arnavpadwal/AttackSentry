# AttackSentry — environment variables (copy to .env and fill in)

# --- Secrets (REQUIRED — change these) ---
SENTRY_SECRET_KEY=change-me-to-a-long-random-string
SENTRY_BOOTSTRAP_ADMIN_PASSWORD=change-me-to-a-strong-password
POSTGRES_PASSWORD=change-me-db-password
NATS_PASSWORD=change-me-nats-password

# --- Database ---
POSTGRES_USER=attacksentry
POSTGRES_DB=attacksentry
NATS_USER=attacksentry
NATS_BIND_HOST=127.0.0.1
NATS_PORT=4222

# --- Optional LLM (AI triage) ---
SENTRY_LLM_PROVIDER=none
SENTRY_LLM_BASE_URL=http://host.docker.internal:1234
SENTRY_LLM_MODEL=default
SENTRY_LLM_API_KEY=not-needed
SENTRY_LLM_INCLUDE_SENSITIVE_CONTEXT=false
SENTRY_LLM_BATCH_WINDOW_SECONDS=3
SENTRY_LLM_BATCH_MAX_EVIDENCE=12
SENTRY_LLM_MAX_CONCURRENCY=2
SENTRY_LLM_MIN_INTERVAL_SECONDS=1

# --- SIEM/SOAR webhook and automated response (optional) ---
# SENTRY_WEBHOOK_URL=https://soar.example.com/hooks/attacksentry
# SENTRY_WEBHOOK_SECRET=replace-with-at-least-16-random-characters
SENTRY_WEBHOOK_MIN_SEVERITY=high
SENTRY_RESPONSE_MODE=disabled
SENTRY_RESPONSE_MIN_SEVERITY=critical
SENTRY_RESPONSE_MIN_CONFIDENCE=0.9
SENTRY_RESPONSE_ACTION=dynamic
SENTRY_RESPONSE_TTL_MINUTES=60

# --- Detection tuning ---
SENTRY_BASELINE_HOURS=72
SENTRY_RETENTION_DAYS=30

# --- Frontend port ---
FRONTEND_PORT=8080
SENTRY_COOKIE_SECURE=false
SENTRY_LOG_FORMAT=json
SENTRY_LOG_LEVEL=INFO
