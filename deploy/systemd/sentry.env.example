SENTRY_ENVIRONMENT=production
SENTRY_SECRET_KEY=replace-with-at-least-32-random-characters
SENTRY_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-initial-password
SENTRY_DATABASE_URL=postgresql+psycopg://attacksentry:password@127.0.0.1:5432/attacksentry
SENTRY_TIMESCALE_ENABLED=true
SENTRY_NATS_URL=nats://attacksentry:password@127.0.0.1:4222
SENTRY_COOKIE_SECURE=true
SENTRY_LLM_PROVIDER=none
SENTRY_BASELINE_HOURS=72
SENTRY_RETENTION_DAYS=30
SENTRY_LOG_FORMAT=json
SENTRY_LOG_LEVEL=INFO
SENTRY_WEBHOOK_URL=
SENTRY_WEBHOOK_SECRET=
SENTRY_RESPONSE_MODE=disabled
