# AttackSentry backend environment.
# Copy to .env for local development and replace every secret.
SENTRY_ENVIRONMENT=development
SENTRY_DEBUG=false
SENTRY_SECRET_KEY=replace-with-at-least-32-random-characters
SENTRY_BOOTSTRAP_ADMIN_USERNAME=admin
SENTRY_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password
SENTRY_BOOTSTRAP_ADMIN_EMAIL=admin@localhost

# SQLite is the zero-setup default. Production should use PostgreSQL + TimescaleDB.
SENTRY_DATABASE_URL=sqlite+aiosqlite:///./attacksentry.db
SENTRY_TIMESCALE_ENABLED=false
SENTRY_RETENTION_DAYS=30
SENTRY_RETENTION_CLEANUP_HOURS=6

# Optional NATS ingestion. Empty means REST-only ingestion.
SENTRY_NATS_URL=
SENTRY_NATS_SUBJECT=sentry.flows
SENTRY_NATS_STREAM=SENTRY

# Detection lifecycle
SENTRY_BASELINE_HOURS=72
SENTRY_RESERVOIR_SIZE=5000
SENTRY_INCIDENT_WINDOW_SECONDS=300
SENTRY_SUPPRESSION_WINDOW_SECONDS=600
SENTRY_MIN_ATTACK_CONFIDENCE=0.5
SENTRY_STRONG_ANOMALY_THRESHOLD=50
SENTRY_ZERO_DAY_MAX_CONFIDENCE=0.10

# AI triage. Use local providers where possible.
SENTRY_LLM_PROVIDER=none
SENTRY_LLM_BASE_URL=http://127.0.0.1:1234
SENTRY_LLM_MODEL=default
SENTRY_LLM_API_KEY=not-needed
SENTRY_LLM_INCLUDE_SENSITIVE_CONTEXT=false
SENTRY_LLM_TIMEOUT=60
SENTRY_LLM_BATCH_WINDOW_SECONDS=3
SENTRY_LLM_BATCH_MAX_EVIDENCE=12
SENTRY_LLM_MAX_CONCURRENCY=2
SENTRY_LLM_MIN_INTERVAL_SECONDS=1
SENTRY_LLM_MAX_RETRIES=3
SENTRY_LLM_QUEUE_CAPACITY=500

# Optional SIEM/SOAR webhook and automated response.
SENTRY_WEBHOOK_URL=
SENTRY_WEBHOOK_SECRET=
SENTRY_WEBHOOK_MIN_SEVERITY=high
SENTRY_RESPONSE_MODE=disabled
SENTRY_RESPONSE_MIN_SEVERITY=critical
SENTRY_RESPONSE_MIN_CONFIDENCE=0.9
SENTRY_RESPONSE_ACTION=dynamic
SENTRY_RESPONSE_TTL_MINUTES=60
SENTRY_RESPONSE_AUTO_RESOLVE=false

# Local HTTP development only. Keep true behind HTTPS.
SENTRY_COOKIE_SECURE=false
SENTRY_LOG_FORMAT=console
SENTRY_LOG_LEVEL=INFO
